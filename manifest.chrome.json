{
  "manifest_version": 3,
  "name": "Ika Governor",
  "version": "1.0",
  "description": "Planificador de construcción, niveles y tropas en Ikariam",
  "permissions": ["storage", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Ika Governor"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
