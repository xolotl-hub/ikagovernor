{
  "manifest_version": 3,
  "name": "Ikariam Build Planner",
  "version": "1.0",
  "description": "Planificador de construcción, niveles y tropas en Ikariam",
  "permissions": ["storage", "sidePanel"],
  "browser_specific_settings": {
    "gecko": {
      "id": "ikariam-planner@local",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Abrir panel de Ikariam"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "sidebar_action": {
    "default_panel": "popup.html",
    "default_title": "Ikariam Build Planner",
    "open_at_install": true
  }
}
