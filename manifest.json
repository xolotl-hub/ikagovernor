{
  "manifest_version": 3,
  "name": "Ika Governor",
  "version": "1.0",
  "description": "Planificador de construcción, niveles y tropas en Ikariam",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "ikagovernor@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "action": {
    "default_title": "Abrir Ika Governor",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "Ika Governor",
    "default_panel": "popup.html"
  }
}
